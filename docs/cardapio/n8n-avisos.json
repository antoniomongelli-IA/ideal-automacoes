    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Monta o aviso de erro para VOCÊ (troque pelo seu número, com 55 + DDD)\nconst MEU_NUMERO = '55DDDSEUNUMERO';\nconst d = $json.body ?? $json;\nconst mensagem =\n  `⚠️ *Erro no cardápio*\\n\\n` +\n  (d.estabelecimento_nome ? `Estabelecimento: ${d.estabelecimento_nome}\\n` : '') +\n  `Página: ${d.pagina || '-'}\\n` +\n  `Erro: ${d.mensagem}\\n` +\n  `Celular: ${d.navegador || '-'}\\n` +\n  `Versão do site: ${d.versao || '-'}`;\nreturn { json: { telefone: MEU_NUMERO, mensagem } };"
      },
