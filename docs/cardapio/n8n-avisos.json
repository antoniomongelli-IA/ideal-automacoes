    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Monta a mensagem com o código de \"esqueci minha senha\"\nconst d = $json.body ?? $json;\nconst telefone = String(d.telefone || '').replace(/\\D/g, ''); // já vem 55 + DDD + número\nconst onde = d.tipo === 'dono'\n  ? `no painel do *${d.estabelecimento_nome || 'seu cardápio'}*`\n  : `na sua conta do cardápio${d.estabelecimento_nome ? ` do *${d.estabelecimento_nome}*` : ''}`;\nconst ola = d.tipo === 'dono' || !d.primeiro_nome ? 'Olá!' : `Olá, ${d.primeiro_nome}!`;\nconst mensagem =\n  `${ola} 🔐\\n\\n` +\n  `Seu código para criar uma nova senha ${onde} é:\\n\\n` +\n  `*${d.codigo}*\\n\\n` +\n  `Ele vale por ${d.validade_minutos || 10} minutos. Se não foi você que pediu, é só ignorar esta mensagem.`;\nreturn { json: { telefone, mensagem } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "id": "2d39d7a5-c7c5-485c-8c71-119e4adc3454",
      "name": "Mensagem do código"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://SUA-EVOLUTION-API/message/sendText/SUA-INSTANCIA",
